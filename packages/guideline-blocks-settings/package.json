{
    "name": "@frontify/guideline-blocks-settings",
    "type": "module",
    "version": "4.0.0-alpha.1",
    "description": "Provides types and helpers for the guideline block development",
    "author": "Frontify Developers <developers@frontify.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/Frontify/brand-sdk",
        "directory": "packages/guideline-blocks-settings"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.umd.js",
            "import": "./dist/index.es.js"
        },
        "./styles": "./dist/styles.css",
        "./tailwind": "./tailwind.config.ts"
    },
    "main": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "tailwind.config.ts"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "test": "vitest run --silent",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "peerDependencies": {
        "@frontify/app-bridge": "^4.0.0-alpha.0",
        "react": "^18",
        "react-dom": "^18"
    },
    "dependencies": {
        "@ctrl/tinycolor": "^4.2.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@frontify/fondue": "^13.7.8",
        "@frontify/sidebar-settings": "workspace:^",
        "@tailwindcss/container-queries": "^0.1.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@frontify/oxfmt-config": "^0.0.2",
        "@frontify/oxlint-config-react": "^0.0.2",
        "@microsoft/api-extractor": "^7.58.12",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "14.6.6",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "^24.11.0",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@types/sinon": "^21.0.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/ui": "^4.1.10",
        "autoprefixer": "^10.4.27",
        "eslint-plugin-tailwindcss": "^3.18.3",
        "happy-dom": "^20.9.0",
        "mitt": "^3.0.1",
        "msw": "^2.12.14",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rollup": "^4.60.1",
        "sinon": "21.0.3",
        "tailwindcss": "^3.4.18",
        "typescript": "^5.9.3",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vite-plugin-externals": "^0.6.2",
        "vitest": "^4.1.10"
    }
